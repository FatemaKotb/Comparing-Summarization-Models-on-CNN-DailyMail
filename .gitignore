# ---------------------------------------------------------------------------
# Build / environment artifacts only.
# Committed results (models/**/outputs/*_eval_*.json) and
# models/recurrent/artifacts/vocab.json are intentionally NOT ignored.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
.env

# Notebooks
.ipynb_checkpoints/

# OS / archive junk
.DS_Store
Thumbs.db
__MACOSX/
*.zip

# Training outputs (written relative to each package root)
checkpoints/
runs/
wandb/
*.pt
*.pth
*.ckpt

# Generated predictions (large, reproducible); eval JSONs stay tracked
models/transformer/pretrained_seq2seq/outputs/*_predictions.json

# Datasets. Anchored on purpose: a bare `data/` would also ignore the
# models/recurrent/src/data/ Python package.
/data/
models/transformer/*/data/
